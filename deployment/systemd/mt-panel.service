[Unit]
Description=MT Panel control-plane (read-only pilot)
After=network.target mt-panel-agent.service
Wants=mt-panel-agent.service

[Service]
Type=simple
User=mtpanel
Group=mtpanel
WorkingDirectory=/opt/mt-panel
EnvironmentFile=/etc/mt-panel/mt-panel.env
ExecStart=/opt/mt-panel/.venv/bin/python -m uvicorn --factory panel.api:app_factory --host 127.0.0.1 --port 8086
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectControlGroups=true
ProtectKernelTunables=true
ProtectKernelModules=true
LockPersonality=true
RestrictSUIDSGID=true
CapabilityBoundingSet=
AmbientCapabilities=
ReadWritePaths=/var/lib/mt-panel

[Install]
WantedBy=multi-user.target
