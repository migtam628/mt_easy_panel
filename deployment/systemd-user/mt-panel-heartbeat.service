[Unit]
Description=MT Panel signed private-Tailscale heartbeat (identity only)
Documentation=https://github.com/migtam628/mt_easy_panel/blob/main/docs/REMOTE_AGENT_ENROLLMENT.md

[Service]
Type=oneshot
WorkingDirectory=%h/mt_easy_panel
ExecStart=%h/mt_easy_panel/.venv/bin/python -m agent.heartbeat --once --config %h/.config/mt-panel/heartbeat.json
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
# User-level service. No docker group, privileged agent, or listening socket.
