# Generate your own independent secrets; never commit .env.
# Agent and panel must use the same long random AGENT_TOKEN.
AGENT_TOKEN=REPLACE_WITH_64_PLUS_RANDOM_HEX_CHARACTERS
AGENT_BIND=127.0.0.1
AGENT_PORT=8788
# Enable only for local UI testing, never real inventory:
AGENT_DEMO_MODE=false
# Optional: absolute path to a LOCAL Docker Unix socket; useful for Docker Desktop on macOS.
# DOCKER_SOCKET_PATH=/Users/YOU/.docker/run/docker.sock

PANEL_BIND=127.0.0.1
PANEL_PORT=8086
PANEL_DB_PATH=./state/panel.db
PANEL_AGENT_URL=http://127.0.0.1:8788
# Must match the browser's exact origin (scheme, hostname, port).
PANEL_PUBLIC_ORIGIN=http://127.0.0.1:8086
# Set true when serving behind HTTPS (including Tailscale HTTPS).
PANEL_COOKIE_SECURE=false
